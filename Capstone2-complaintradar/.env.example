# Optional. If omitted, ComplaintRadar runs in offline mock-LLM mode.
GROQ_API_KEY=

# Set to true inside Docker Compose / Kubernetes.
USE_DOCKER=false

ELASTICSEARCH_URL=http://localhost:9200
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=complaintradar_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Re-pull CFPB from the live API through dlt (otherwise the committed snapshot is used).
CFPB_FORCE_REFRESH=false
