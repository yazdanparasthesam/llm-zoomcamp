# --- LLM (leave empty for zero-config offline mock mode) ---
GROQ_API_KEY=
LLM_PROVIDER=groq
# Optional OpenAI alternative (LLM_PROVIDER=openai)
OPENAI_API_KEY=

# --- Optional LIVE flight offers (otherwise committed snapshot is used) ---
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# --- Optional REAL Kaggle dataset (downloaded with your own account) ---
TRIPILOT_REAL_KAGGLE_CSV=
# set true to re-run dlt even when the normalized extract exists
TRIPILOT_FORCE_REFRESH=false

# --- Telemetry (docker-compose sets these for you) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tripilot_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Optional Elasticsearch mirror ---
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
